{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Unjuno/orbitune/schemas/base_manifest.schema.json",
  "title": "Orbitune Base Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "id", "display_name", "architecture", "tokenizer", "parameter_count", "checkpoint", "web_onnx", "license", "training_data", "lineage", "tags"],
  "allOf": [
    {
      "if": {
        "properties": {
          "lineage": {
            "properties": {"commercial_eligible": {"const": true}},
            "required": ["commercial_eligible"]
          }
        }
      },
      "then": {
        "properties": {
          "lineage": {
            "properties": {
              "license_policy": {"const": "prod-only"},
              "distribution_scope": {"const": "commercial"},
              "restricted_source_ids": {"maxItems": 0}
            }
          },
          "license": {
            "not": {
              "enum": [
                "CC-BY-NC-3.0",
                "CC-BY-NC-4.0",
                "CC-BY-NC-SA-3.0",
                "CC-BY-NC-SA-4.0"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lineage": {
            "properties": {"commercial_eligible": {"const": false}},
            "required": ["commercial_eligible"]
          }
        }
      },
      "then": {
        "properties": {
          "lineage": {
            "properties": {
              "license_policy": {"enum": ["research-nc", "restricted"]},
              "distribution_scope": {"enum": ["noncommercial", "internal-only"]}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lineage": {
            "properties": {"license_policy": {"const": "restricted"}},
            "required": ["license_policy"]
          }
        }
      },
      "then": {
        "properties": {
          "lineage": {
            "properties": {
              "commercial_eligible": {"const": false},
              "distribution_scope": {"const": "internal-only"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lineage": {
            "properties": {"license_policy": {"const": "research-nc"}},
            "required": ["license_policy"]
          }
        }
      },
      "then": {
        "properties": {
          "lineage": {
            "properties": {
              "commercial_eligible": {"const": false},
              "distribution_scope": {"enum": ["noncommercial", "internal-only"]}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lineage": {
            "properties": {"distribution_scope": {"enum": ["noncommercial", "internal-only"]}},
            "required": ["distribution_scope"]
          }
        }
      },
      "then": {
        "properties": {
          "license": {
            "not": {
              "enum": [
                "Apache-2.0",
                "MIT",
                "BSD-2-Clause",
                "BSD-3-Clause",
                "ISC",
                "MPL-2.0",
                "GPL-2.0",
                "GPL-2.0-only",
                "GPL-3.0",
                "GPL-3.0-only",
                "AGPL-3.0",
                "AGPL-3.0-only",
                "LGPL-2.1",
                "LGPL-2.1-only",
                "LGPL-3.0",
                "LGPL-3.0-only",
                "CC0-1.0",
                "CC-BY-3.0",
                "CC-BY-4.0",
                "CC-BY-SA-3.0",
                "CC-BY-SA-4.0"
              ]
            }
          }
        }
      }
    }
  ],
  "properties": {
    "artifact_type": {"const": "orbitune_base"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "author": {"type": "string"},
    "architecture": {"type": "string", "minLength": 1},
    "tokenizer": {"type": "string", "minLength": 1},
    "parameter_count": {"type": "integer", "minimum": 1, "maximum": 100000000},
    "checkpoint": {"$ref": "#/$defs/artifact"},
    "web_onnx": {"$ref": "#/$defs/artifact"},
    "license": {"type": "string", "minLength": 1},
    "training_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "license", "rights_confirmed"],
      "properties": {
        "source_type": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "rights_confirmed": {"const": true},
        "notes": {"type": "string"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_checkpoint", "commercial_eligible", "distribution_scope", "license_policy", "corpus_registry", "corpus_manifest_sha256", "restricted_source_ids", "rights_summary"],
      "properties": {
        "parent_checkpoint": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "sha256"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
                "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
              }
            }
          ]
        },
        "commercial_eligible": {"type": "boolean"},
        "distribution_scope": {"enum": ["commercial", "noncommercial", "internal-only"]},
        "license_policy": {"enum": ["prod-only", "research-nc", "restricted"]},
        "corpus_registry": {"type": "string", "minLength": 1},
        "corpus_manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "restricted_source_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "rights_summary": {"type": "string", "minLength": 1}
      }
    },
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "bytes"],
      "properties": {
        "filename": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 99614720}
      }
    }
  }
}
