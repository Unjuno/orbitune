{
  "schema_version": 1,
  "name": "orbitune-commercial-safe-v4",
  "purpose": "Commercial-safe Base pretraining corpus v4: v3 plus two new free-license score/MIDI corpora (NRG-CP and Groove MIDI Dataset), with the PDMX upstream deduplicated filter relaxed to expose more pre-1900 piano-roll material for cross-source Orbitune-level dedup.",
  "license_policy": {
    "allow": ["public-domain", "cc0-1.0", "cc-by-4.0", "cc-by-3.0"],
    "deny_markers": ["-nc", "noncommercial", "unknown", "unclear", "sharealike", "cc-by-sa"],
    "note": "Dataset inclusion is conservative and is not legal advice. Per-item provenance remains in the generated manifest."
  },
  "sources": [
    {
      "id": "pdmx",
      "tier": "primary",
      "kind": "zenodo_pdmx",
      "license": "cc-by-4.0/public-domain-compositions",
      "commercial_safe": true,
      "record_id": 15571083,
      "landing_url": "https://zenodo.org/records/15571083",
      "required_files": ["PDMX.csv", "mid.tar.gz", "subset_paths.tar.gz"],
      "filters": ["no_license_conflict", "midi_available"],
      "quality_weight": 1.0,
      "v3_filters_relaxed": ["deduplicated"],
      "v4_relaxation_note": "PDMX upstream 'deduplicated' flag is dropped. Replacement production dedup is Orbitune's exact normalized-event fingerprint dedup applied at corpus build time; composition_fingerprint_v1 remains the conservative split-grouping key. License gate ('no_license_conflict') is preserved."
    },
    {
      "id": "openscore_lieder",
      "tier": "quality-anchor",
      "kind": "git_scores",
      "license": "cc0-1.0",
