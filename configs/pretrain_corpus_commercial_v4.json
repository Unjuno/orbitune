      "ref": "6b2dc542ce2e8aa4b78c8ee62103b210efc07015",
      "score_globs": ["scores/**/*.mscz", "scores/**/*.mscx"],
      "quality_weight": 2.0
    },
    {
      "id": "openscore_string_quartets",
      "tier": "quality-anchor",
      "kind": "git_scores",
      "license": "cc0-1.0",
