      "landing_url": "https://zenodo.org/records/15304989",
      "archive_type": "tar.gz",
      "checksum_algorithm": "md5",
      "checksum": "7443fe30674ef149aa4c23580044f597",
      "expected_file_globs": ["**/*.mid", "**/*.midi"],
      "quality_weight": 1.0,
      "attribution_required": true,
      "provenance_note": "NRG-CP MIDI Dataset (Zenodo record 15304989, CC BY 4.0). Installer verifies MD5 against the audit-census value before extraction and refuses to extract on mismatch."
    },
    {
      "id": "groove_midi_dataset",
      "tier": "supplement",
      "kind": "remote_archive",
      "license": "cc-by-4.0",
      "commercial_safe": true,
      "url": "https://storage.googleapis.com/magentadata/datasets/groove/groove-v1.0.0-midionly.zip",
      "landing_url": "https://magenta.tensorflow.org/datasets/groove",
      "archive_type": "zip",
      "checksum_algorithm": "sha256",
      "checksum": "651cbc524ffb891be1a3e46d89dc82a1cecb09a57c748c7b45b844c4841dcc1e",
      "expected_file_globs": ["**/*.mid", "**/*.midi"],
      "quality_weight": 1.0,
      "attribution_required": true,
      "provenance_note": "Groove MIDI Dataset v1.0.0 midionly.zip (CC BY 4.0) from the official Magenta Google Cloud Storage mirror (same content as the Hugging Face amazon/groove upload, same pinned SHA256). Only the midionly archive is admitted; the E-GMD expansion is not ingested to avoid redundant re-recordings."
    }
  ],
  "sampling": {
    "track_buckets": {
      "solo": 0.40,
      "small_ensemble_2_5": 0.50,
      "large_ensemble_6_plus": 0.10
    },
    "quality_multipliers": {
      "ordinary": 1.0,
      "rated": 1.5,
      "high_rated": 2.0,
      "openscore_verified": 2.0
    }
  },
  "split": {
    "unit": "composition_fingerprint_v1",
    "validation_fraction": 0.05,
    "test_fraction": 0.01,
    "seed": "orbitune-commercial-safe-v1"
  }
}
